# Optional: enables the Operator Copilot (Claude). Everything else works without it.
ANTHROPIC_API_KEY=

# Optional: host names/IPs the API answers to (DNS-rebinding protection). Add your LAN IP to demo
# on a network, together with publishing the web port on all interfaces in docker-compose.yml.
# CASCAST_ALLOWED_HOSTS=["localhost","127.0.0.1","192.168.1.20"]
